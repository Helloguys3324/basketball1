# =============================================================================
# DISCORD BOT CONFIGURATION (.env)
# =============================================================================

# Discord Bot Token (from Discord Developer Portal)
DISCORD_TOKEN=your_discord_bot_token_here

# ── Multi-Tier Cascading AI Moderation Engine ────────────────────────────────

# Tier 1: Free OpenAI Moderation API Key (omni-moderation-latest, $0 cost)
# Absorbs ~95%+ of all chat traffic with 0ms fast-gating and zero LLM billing.
OPENAI_API_KEY=sk-proj-...

# Tier 2: Groq API Keys (Llama 8B & Llama 70B rate limits pooled together)
# Multiple keys separated by comma for automatic atomic round-robin & auto-failover:
GROQ_API_KEYS=gsk_key1,gsk_key2,gsk_key3,gsk_key4

# Fast Model: Llama 3.1 8B (Used for instant re-checking of >85% cases to prevent false deletions)
GROQ_FAST_MODEL=llama-3.1-8b-instant

# Deep Context Model: Llama 3.3 70B (Used for Grey Zone 0.45..0.85 with full chat IDs & history context)
GROQ_DEEP_MODEL=llama-3.3-70b-versatile

# Tier 1 Batching Optimization (0ms for instantaneous moderation)
OPENAI_MODERATION_BATCH_SIZE=100
OPENAI_MODERATION_BATCH_TIMEOUT_MS=0

# Tier 2 Groq Batching Optimization (0ms for instantaneous moderation)
GROQ_MODERATION_BATCH_SIZE=8
GROQ_MODERATION_BATCH_TIMEOUT_MS=0

# ── Tier 3: Google Gemini High-Intelligence Frontier Arbiter ──────────────────
# Primary reasoning engine before falling back to Groq cluster
# Multiple keys separated by comma for safe atomic round-robin from ONE single IP (prevents Google leak ban!):
# GEMINI_API_KEYS=AIzaSyKey1,AIzaSyKey2,AIzaSyKey3
GEMINI_API_KEYS=AIzaSy...
# Fast Model options: gemini-3.1-flash-lite, gemini-3.5-flash-lite
GEMINI_FAST_MODEL=gemini-3.1-flash-lite
# Deep Reasoning Model options: gemini-3.5-flash-lite, gemma-4-31b-it
GEMINI_DEEP_MODEL=gemini-3.5-flash-lite
# Optional: Dedicated private Cloudflare reverse proxy endpoint (prevents regional blocks)
# GEMINI_API_ENDPOINT=https://my-worker.workers.dev


